# =========================
# Node.js Backend Gitignore
# =========================

# Dependências
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / compilação
dist/
build/
out/

# Ambiente
.env
.env.*
!.env.example

# Cache
.cache/
.tmp/
.temp/

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs / Editores
.vscode/
.idea/
*.swp
*.swo

# Testes
coverage/
.nyc_output/

# Banco de dados local
*.sqlite
*.sqlite3
*.db

# Uploads temporários
uploads/
tmp/

# Arquivos de runtime
pids/
*.pid
*.seed
*.pid.lock

# TypeScript
*.tsbuildinfo

# Docker
docker-compose.override.yml

# PM2
.pm2/

# Prisma
prisma/dev.db
prisma/dev.db-journal

# TurboRepo
.turbo/

# Next.js (caso use APIs)
.next/

# Expo / React Native backend tools
.expo/

# Firebase
.firebase/

# Sentry
.sentryclirc

# Arquivos compactados
*.zip
*.tar
*.gz

# Certificados / chaves
*.pem
*.key
*.crt

# Mac/Linux hidden
.*.swp